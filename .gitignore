# Maven build output
target/

# Compiled classes and logs
*.class
*.log

# IDE and editor files
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS files
.DS_Store

# Local group data saved by the program (your data, not source code).
# susu-group.txt is the default (Storage.DEFAULT_FILE); /*.txt also covers files
# chosen with --file in the project folder, such as office.txt in the README.
susu-group.txt
/*.txt
*.tmp
